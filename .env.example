# PostgreSQL connection string. Required — the app throws on any waitlist
# API call (and on page render) until this is set.
DATABASE_URL=postgres://user:password@host:5432/atrum

# Set to "false" only for a local Postgres with no TLS. Anything else uses
# `ssl: { rejectUnauthorized: false }`, which fits most managed Postgres hosts.
PGSSL=true

# Added to the real signup count for display. Defaults to 0 (honest raw
# count) — only set this if you deliberately want an offset.
WAITLIST_BASE_COUNT=0

# Salt used to derive the pseudonymous "0x1a2b…c3d" ids shown in the live
# feed. Set to a random secret in production so ids aren't guessable from a
# signup's row id.
WAITLIST_ID_SALT=change-me-in-production

# Public origin used to build invite links (e.g. atrum.fun/oath/ATR-1A).
# Must be prefixed NEXT_PUBLIC_ to be readable from the browser.
NEXT_PUBLIC_SITE_ORIGIN=atrum.fun
